<Application
    x:Class="AniDesk.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVis" />
            <converters:WidthToSixteenNineHeightConverter x:Key="W169H" />
            <converters:WidthToColumnCountConverter x:Key="WToColumns" />
            <converters:AspectRatioConverter x:Key="AspectRatioConverter" />
            <converters:BoolToSidebarWidthConverter x:Key="BoolToSidebarWidthConverter" />
            <converters:ValueEqualsToBoolConverter x:Key="ValueEqualsToBoolConverter" />
            <converters:StringEqualsToBrushConverter x:Key="StringEqualsToBrushConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#E05070" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToStringConverter x:Key="SfwTitleConverter" TrueString="SFW Shield" FalseString="Unrestricted" />
            <converters:BoolToStringConverter x:Key="SfwStatusConverter" TrueString="Strict Safe" FalseString="All Content" />
            <converters:BoolToStringConverter x:Key="SfwPillLabelConverter" TrueString="SFW Shield: Safe" FalseString="SFW Shield: Off" />

            <!-- Discrete SFW indicator colors: emerald for safe, discreet slate/amber for unrestricted (never shocking red) -->
            <converters:BoolToBrushConverter x:Key="SfwColorConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#10B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToBrushConverter x:Key="SfwBgConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#1A10B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#1A94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToBrushConverter x:Key="SfwBorderConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#3310B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#3394A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <!-- Global Accent & Translucent Mica Dark Modern Brushes -->
            <SolidColorBrush x:Key="MicaWindowBackground" Color="#550A0D15" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#880F131D" />
            <SolidColorBrush x:Key="SurfaceCardBackground" Color="#99161B26" />
            <SolidColorBrush x:Key="SurfaceBorderSubtle" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AccentDefault" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentGlow" Color="#330078D4" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9DA6B8" />
            <SolidColorBrush x:Key="TextTertiary" Color="#656E82" />
            <SolidColorBrush x:Key="SafeGreen" Color="#10B981" />
            <SolidColorBrush x:Key="SafeGreenBg" Color="#2010B981" />
            <SolidColorBrush x:Key="NavActiveIndicatorBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#330078D4" />
            <SolidColorBrush x:Key="TranslucentNavRailBackground" Color="#880F131D" />
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="Transparent" />

            <!-- Global Dark Modern ComboBox Style (Deep Slate Surface, Zero White Flash) -->
            <Style x:Key="AniDeskCleanComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="Background" Value="#161B27" />
                <Setter Property="BorderBrush" Value="#2A354A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,0,32,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <!-- Full-width ToggleButton for dropdown activation (no arrows, just the border) -->
                                <ToggleButton
                                    x:Name="ToggleButton"
                                    Focusable="False"
                                    Padding="0"
                                    ClickMode="Press"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="TgBorder"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <!-- Chevron arrow pinned to the right -->
                                                <Path x:Name="Arrow"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,11,0"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#94A3B8"
                                                      StrokeThickness="1.5"
                                                      SnapsToDevicePixels="True" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TgBorder" Property="Background" Value="#222B3D" />
                                                    <Setter TargetName="TgBorder" Property="BorderBrush" Value="#0078D4" />
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="TgBorder" Property="Background" Value="#1A2234" />
                                                    <Setter TargetName="TgBorder" Property="BorderBrush" Value="#0078D4" />
                                                    <Setter TargetName="Arrow" Property="Stroke" Value="#0078D4" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="TgBorder" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Content presenter: hardcoded margin keeps text left-padded and arrow-gap on right -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    IsHitTestVisible="False"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    Margin="12,0,36,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left" />

                                <Popup
                                    x:Name="Popup"
                                    Placement="Bottom"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="260">
                                        <Border
                                            x:Name="DropDownBorder"
                                            Background="#141924"
                                            BorderBrush="#2A354A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,4,0,8"
                                            Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
                                            </Border.Effect>
                                            <ScrollViewer SnapsToDevicePixels="True" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AniDeskCleanComboBoxStyle}" />

            <!-- Global Dark Modern ComboBoxItem Style -->
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#E2E8F0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#222B3D" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,0" />
            </Style>

            <!-- Shimmer Animation Storyboard -->
            <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0.3" To="0.8" Duration="0:0:0.9"
                    AutoReverse="True" />
            </Storyboard>
        </ResourceDictionary>
    </Application.Resources>
</Application>
