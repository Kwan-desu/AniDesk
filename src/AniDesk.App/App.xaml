<Application
    x:Class="AniDesk.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVis" />
            <converters:WidthToSixteenNineHeightConverter x:Key="W169H" />
            <converters:WidthToColumnCountConverter x:Key="WToColumns" />
            <converters:AspectRatioConverter x:Key="AspectRatioConverter" />
            <converters:ValueEqualsToBoolConverter x:Key="ValueEqualsToBoolConverter" />
            <converters:StringEqualsToBrushConverter x:Key="StringEqualsToBrushConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#E05070" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToStringConverter x:Key="SfwTitleConverter" TrueString="SFW Shield" FalseString="Unrestricted" />
            <converters:BoolToStringConverter x:Key="SfwStatusConverter" TrueString="Strict Safe" FalseString="All Content" />
            <converters:BoolToStringConverter x:Key="SfwPillLabelConverter" TrueString="SFW Shield: Safe" FalseString="SFW Shield: Off" />

            <!-- Discrete SFW indicator colors: emerald for safe, discreet slate/amber for unrestricted (never shocking red) -->
            <converters:BoolToBrushConverter x:Key="SfwColorConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#10B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToBrushConverter x:Key="SfwBgConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#1A10B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#1A94A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <converters:BoolToBrushConverter x:Key="SfwBorderConverter">
                <converters:BoolToBrushConverter.TrueBrush>
                    <SolidColorBrush Color="#3310B981" />
                </converters:BoolToBrushConverter.TrueBrush>
                <converters:BoolToBrushConverter.FalseBrush>
                    <SolidColorBrush Color="#3394A3B8" />
                </converters:BoolToBrushConverter.FalseBrush>
            </converters:BoolToBrushConverter>

            <!-- Global Accent & Translucent Mica Dark Modern Brushes -->
            <SolidColorBrush x:Key="MicaWindowBackground" Color="#550A0D15" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#880F131D" />
            <SolidColorBrush x:Key="SurfaceCardBackground" Color="#99161B26" />
            <SolidColorBrush x:Key="SurfaceBorderSubtle" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AccentDefault" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentGlow" Color="#330078D4" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9DA6B8" />
            <SolidColorBrush x:Key="TextTertiary" Color="#656E82" />
            <SolidColorBrush x:Key="SafeGreen" Color="#10B981" />
            <SolidColorBrush x:Key="SafeGreenBg" Color="#2010B981" />
            <SolidColorBrush x:Key="NavActiveIndicatorBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#330078D4" />
            <SolidColorBrush x:Key="TranslucentNavRailBackground" Color="#880F131D" />
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="Transparent" />

            <!-- Global Control Styles (Zero Clipping, 38px Ergonomics) -->
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,0" />
            </Style>

            <!-- Shimmer Animation Storyboard -->
            <Storyboard x:Key="ShimmerStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetProperty="(UIElement.Opacity)"
                    From="0.3" To="0.8" Duration="0:0:0.9"
                    AutoReverse="True" />
            </Storyboard>
        </ResourceDictionary>
    </Application.Resources>
</Application>
