<UserControl
    x:Class="AniDesk.App.Views.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:FavoritesViewModel}">

    <Grid Background="Transparent">
        <!-- 1. Refined Windows 11 Empty State -->
        <Border
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#121622"
            BorderBrush="#25FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="36,32"
            MaxWidth="460">
            <StackPanel HorizontalAlignment="Center">
                <Border
                    Width="68" Height="68"
                    CornerRadius="34"
                    Background="#1E273A"
                    BorderBrush="#2F3C57"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="Star24" FontSize="28" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No Favorite Wallpapers Yet" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Click the heart icon on any artwork in Explore to pin it here for instant offline rotation and quick access." FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 2. Virtualized Favorites Gallery -->
        <ScrollViewer
            x:Name="FavoritesScrollViewer"
            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            CanContentScroll="True"
            SizeChanged="OnFavoritesSizeChanged"
            Padding="8,8,8,4">

            <ItemsControl
                ItemsSource="{Binding PostRows}"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.CanContentScroll="True">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:GalleryRow Row="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
