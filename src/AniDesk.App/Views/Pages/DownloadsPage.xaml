<UserControl
    x:Class="AniDesk.App.Views.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:DownloadsViewModel}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Downloads Header -->
        <Border Grid.Row="0" Background="#B311151F" BorderBrush="#1F283C" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Downloads" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Track and open your downloaded wallpapers." FontSize="11.5" Foreground="#9DA6B8" />
                </StackPanel>

                <Button
                    DockPanel.Dock="Right"
                    Command="{Binding OpenDownloadFolderCommand}"
                    Background="#1F2535"
                    BorderBrush="#2C3446"
                    Foreground="#FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14" />
                        <TextBlock Text="Open Downloads Folder" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Downloads List -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="#161B27"
                            BorderBrush="#222838"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail Preview -->
                                <Border
                                    Grid.Column="0"
                                    Width="56"
                                    Height="36"
                                    CornerRadius="4"
                                    Background="#10141D"
                                    ClipToBounds="True"
                                    Margin="0,0,14,0">
                                    <Image converters:AsyncImageLoader.ImageUrl="{Binding Post.ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>

                                <!-- Info & Progress -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="#9DA6B8" Margin="0,2,0,0">
                                        <Run Text="{Binding Post.FormattedDimensions}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding Status}" />
                                    </TextBlock>
                                    <ProgressBar
                                        Value="{Binding Progress}"
                                        Maximum="100"
                                        Height="3"
                                        Margin="0,4,0,0"
                                        Visibility="{Binding Status, Converter={StaticResource EqualityToVis}, ConverterParameter='Downloading'}" />
                                </StackPanel>

                                <!-- Action -->
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Background="#202636"
                                    BorderBrush="#2C3446"
                                    Foreground="#E2E8F0"
                                    FontSize="11.5"
                                    Content="Open File" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
