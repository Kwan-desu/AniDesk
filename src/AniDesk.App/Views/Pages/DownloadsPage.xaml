<UserControl
    x:Class="AniDesk.App.Views.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:DownloadsViewModel}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Downloads Header -->
        <Border Grid.Row="0" Background="#B311151F" BorderBrush="#1F283C" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Downloads &amp; Local Wallpapers" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Quickly change your desktop or lock screen to any downloaded wallpaper." FontSize="11.5" Foreground="#9DA6B8" />
                    <!-- Folder path row -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="12" Foreground="#64748B" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding CurrentDownloadFolderPath}"
                            FontSize="11"
                            Foreground="#64748B"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="420" />
                        <Border
                            Background="#1438BDF8"
                            BorderBrush="#2638BDF8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock Text="{Binding WallpaperCountText}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Command="{Binding RefreshDownloadsCommand}"
                        Width="36" Height="34"
                        Margin="0,0,8,0"
                        Padding="0"
                        Background="#1F2535"
                        BorderBrush="#2C3446"
                        Foreground="#38BDF8"
                        ToolTip="Refresh Downloads">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" />
                    </Button>

                    <Button
                        Command="{Binding OpenDownloadFolderCommand}"
                        Height="34"
                        Background="#1F2535"
                        BorderBrush="#2C3446"
                        Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14" />
                            <TextBlock Text="Open Folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Downloads Content -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <StackPanel>
                <!-- Active Downloads Queue (if any) -->
                <TextBlock Text="ACTIVE DOWNLOADS" FontSize="10.5" FontWeight="Bold" Foreground="#656E82" Margin="0,0,0,8"
                           Visibility="{Binding HasActiveDownloads, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Downloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="#161B27"
                                BorderBrush="#222838"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail Preview -->
                                    <Border
                                        Grid.Column="0"
                                        Width="64"
                                        Height="40"
                                        CornerRadius="4"
                                        Background="#10141D"
                                        ClipToBounds="True"
                                        Margin="0,0,14,0">
                                        <Image converters:AsyncImageLoader.ImageUrl="{Binding Post.ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Info & Progress -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="#9DA6B8" Margin="0,2,0,0">
                                            <Run Text="{Binding Post.FormattedDimensions}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Status}" />
                                        </TextBlock>
                                        <ProgressBar
                                            Value="{Binding Progress}"
                                            Maximum="100"
                                            Height="3"
                                            Margin="0,4,0,0"
                                            Visibility="{Binding Status, Converter={StaticResource EqualityToVis}, ConverterParameter='Downloading'}" />
                                    </StackPanel>

                                    <!-- Action -->
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding TargetFilePath}"
                                        Background="#202636"
                                        BorderBrush="#2C3446"
                                        Foreground="#E2E8F0"
                                        FontSize="11.5"
                                        Content="Open File" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Downloaded Wallpapers Section Header -->
                <TextBlock Text="DOWNLOADED WALLPAPERS" FontSize="10.5" FontWeight="Bold" Foreground="#656E82" Margin="0,16,0,10" />

                <!-- Empty State -->
                <Border
                    Visibility="{Binding HasDownloadedFiles, Converter={StaticResource InverseBoolToVis}}"
                    Background="#121622"
                    BorderBrush="#1E2536"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="40,36"
                    Margin="0,4,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#161E2E" BorderBrush="#253248" BorderThickness="1" Margin="0,0,0,14" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderZip24" FontSize="26" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No downloaded wallpapers found in this folder" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Wallpapers you download from Explore or Favorites will appear here." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding OpenDownloadFolderCommand}" Height="34" Padding="14,0" Margin="0,0,8,0" Background="#1F2535" BorderBrush="#2C3446" Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="Open Folder in Explorer" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshDownloadsCommand}" Height="34" Padding="14,0" Background="#0078D4" Foreground="#FFFFFF" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="Refresh Grid" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Adaptive Responsive Thumbnail Grid -->
                <ItemsControl ItemsSource="{Binding LocalWallpapers}"
                              Visibility="{Binding HasDownloadedFiles, Converter={StaticResource BoolToVis}}"
                              Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="280"
                                Background="#161B27"
                                BorderBrush="#252F42"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Margin="0,0,14,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="158" /> <!-- 16:9 Thumbnail -->
                                        <RowDefinition Height="Auto" /> <!-- Info & Actions Footer -->
                                    </Grid.RowDefinitions>

                                    <!-- 16:9 Aspect Ratio Thumbnail (UniformToFill) -->
                                    <Border Grid.Row="0" Background="#0F131D" ClipToBounds="True">
                                        <Image converters:AsyncImageLoader.ImageUrl="{Binding FilePath}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Top-Right File Size Badge -->
                                    <Border Grid.Row="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Background="#CC0B0E14"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock Text="{Binding FormattedFileSize}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                    </Border>

                                    <!-- Footer: Details & Quick Actions -->
                                    <Border Grid.Row="1" Background="#141924" BorderBrush="#1E2536" BorderThickness="0,1,0,0" Padding="10,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- File Name -->
                                            <TextBlock Grid.Row="0" Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                            <DockPanel Grid.Row="1" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding FormattedDate}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />

                                                <!-- Action Buttons -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <!-- Apply Wallpaper -->
                                                    <Button
                                                        Command="{Binding DataContext.SetAsWallpaperCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        Width="28" Height="26"
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        Background="#0078D4"
                                                        BorderThickness="0"
                                                        Foreground="#FFFFFF"
                                                        ToolTip="Set as Desktop Wallpaper">
                                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="13" />
                                                    </Button>

                                                    <!-- Lock Screen -->
                                                    <Button
                                                        Command="{Binding DataContext.SetAsLockScreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        Width="28" Height="26"
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        Background="#1E2536"
                                                        BorderBrush="#2C374D"
                                                        BorderThickness="1"
                                                        Foreground="#E2E8F0"
                                                        ToolTip="Set as Lock Screen">
                                                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="13" />
                                                    </Button>

                                                    <!-- Open in Explorer / Viewer -->
                                                    <Button
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FilePath}"
                                                        Width="28" Height="26"
                                                        Margin="0,0,4,0"
                                                        Padding="0"
                                                        Background="#1E2536"
                                                        BorderBrush="#2C374D"
                                                        BorderThickness="1"
                                                        Foreground="#E2E8F0"
                                                        ToolTip="Open in Default Photo Viewer">
                                                        <ui:SymbolIcon Symbol="Open24" FontSize="13" />
                                                    </Button>

                                                    <!-- Delete -->
                                                    <Button
                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="26"
                                                        Padding="0"
                                                        Background="#1E2536"
                                                        BorderBrush="#2C374D"
                                                        BorderThickness="1"
                                                        Foreground="#EF4444"
                                                        ToolTip="Delete File">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" />
                                                    </Button>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
