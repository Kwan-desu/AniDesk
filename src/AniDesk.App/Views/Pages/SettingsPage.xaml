<UserControl
    x:Class="AniDesk.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="Transparent" Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <!-- Title -->
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
            <TextBlock Text="Customize wallpaper behaviors, emergency panic privacy, and system tray performance." FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,24" />

            <!-- Group 1: Panic Button & Privacy -->
            <TextBlock Text="PANIC BUTTON &amp; PRIVACY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Emergency Desktop Sanitization" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,2" />
                    <TextBlock Text="Pressing the global hotkey instantly hides AniDesk and replaces desktop wallpapers with a clean normal image in under 35ms." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <!-- Enable Emergency Desktop Toggle -->
                    <DockPanel Margin="0,0,0,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Enable Emergency Desktop" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Master toggle to activate or deactivate the global panic hotkey hook" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="EnablePanicSwitch" DockPanel.Dock="Right" IsChecked="True" Click="OnEnablePanicToggled"/>
                    </DockPanel>

                    <Separator Background="#1E2536" Margin="0,0,0,12"/>

                    <!-- Hotkey Information -->
                    <DockPanel Margin="0,0,0,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Global Panic Shortcut" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Active globally in Windows even when AniDesk is hidden in tray" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="#1E273A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <TextBlock Text="Win + Shift + H" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </DockPanel>

                    <Separator Background="#1E2536" Margin="0,0,0,12"/>

                    <!-- Safe Wallpaper Picker -->
                    <TextBlock Text="Emergency Safe Wallpaper" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                    <TextBlock Text="Select which clean image is swapped onto your monitors during emergency mode:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                    <RadioButton x:Name="DefaultWallpaperRadio" Content="Use Windows 11 Built-in Clean Default" GroupName="PanicWallpaper" Foreground="#E2E8F0" Margin="0,0,0,6" />
                    <RadioButton x:Name="CustomWallpaperRadio" Content="Custom Safe Image Path" GroupName="PanicWallpaper" Foreground="#E2E8F0" Margin="0,0,0,8" />

                    <Grid x:Name="CustomPathGrid" Visibility="Collapsed" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PanicWallpaperPathBox" IsReadOnly="True" Height="38"
                                 Background="#121622" Foreground="#FFFFFF" BorderBrush="#252F42" BorderThickness="1"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="12" />
                        <Button Grid.Column="2" Content="Browse..." Height="38" Padding="16,0" Click="OnBrowsePanicWallpaperClicked" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 2: System Tray & Low Usage -->
            <TextBlock Text="SYSTEM TRAY &amp; LOW USAGE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,20">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                            <TextBlock Text="Minimize to System Tray on Close" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Closing the window hibernates AniDesk to the tray (&lt;18 MB RAM, 0% CPU) while keeping the panic hotkey active." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="TraySwitch" DockPanel.Dock="Right" IsChecked="True" Click="OnTrayToggled"/>
                    </DockPanel>

                    <Separator Background="#1E2536" Margin="0,0,0,12"/>

                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                            <TextBlock Text="Run Panic Daemon on Windows Startup" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Automatically launches AniDesk in ultra-low-memory background daemon mode on Windows login." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="StartupSwitch" DockPanel.Dock="Right" Click="OnStartupToggled"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Group 3: Content Safety -->
            <TextBlock Text="CONTENT SAFETY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="SFW Shield Protection" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock Text="Enforces safe content filtering (rating:s) on all explore queries." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:ToggleSwitch
                        x:Name="SfwSwitch"
                        DockPanel.Dock="Right"
                        IsChecked="True"
                        Click="OnSfwToggled" />
                </DockPanel>
            </Border>

            <!-- Group 4: Downloads Directory -->
            <TextBlock Text="DOWNLOADS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Download Location" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,2" />
                    <TextBlock Text="Full-resolution wallpapers will be saved in this directory." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DownloadPathBox" IsReadOnly="True" Height="38"
                                 Background="#121622" Foreground="#FFFFFF" BorderBrush="#252F42" BorderThickness="1"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="12" />
                        <Button Grid.Column="2" Content="Browse..." Height="38" Padding="16,0" Click="OnBrowseClicked" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 5: Storage & Cache -->
            <TextBlock Text="STORAGE &amp; CACHE" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Thumbnail Disk Cache" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                        <TextBlock x:Name="CacheSizeText" Text="Calculating cache size..." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button
                        DockPanel.Dock="Right"
                        Content="Clear Cache"
                        Height="32"
                        Click="OnClearCacheClicked" />
                </DockPanel>
            </Border>

            <!-- Group 6: About -->
            <TextBlock Text="ABOUT ANIDESK" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            <Border Background="#161B27" BorderBrush="#222838" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="AniDesk v1.1.0 — High-Performance Overhaul" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="Windows 11 Fluent Design wallpaper explorer with zero-LOH streaming, instant panic sanitization, and ultra-low-power tray hibernation." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
