<UserControl
    x:Class="AniDesk.App.Views.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    xmlns:models="clr-namespace:AniDesk.Core.Models;assembly=AniDesk.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ExploreViewModel}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Search + Filter Header ── -->
        <Border Grid.Row="0" Background="#B311151F" BorderBrush="#1F283C" BorderThickness="0,0,0,1" Padding="18,12,18,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search + autocomplete -->
                    <Grid Grid.Column="0">
                        <ui:TextBox
                            x:Name="SearchBox"
                            Text="{Binding SearchTags, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search tags (e.g. scenic, starry_sky, artist:wlop)..."
                            Height="38"
                            Icon="Search24"
                            PreviewKeyDown="OnSearchPreviewKeyDown"/>

                        <!-- Suggestions Dropdown Popup (Clicking an item searches) -->
                        <Popup
                            x:Name="SuggestionsPopup"
                            IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                            PlacementTarget="{Binding ElementName=SearchBox}"
                            Placement="Bottom"
                            StaysOpen="False"
                            AllowsTransparency="True">
                            <Border
                                Width="{Binding ActualWidth, ElementName=SearchBox}"
                                MaxHeight="240"
                                Background="#171D2B"
                                BorderBrush="#2C374D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4,0,0"
                                Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
                                </Border.Effect>
                                <ListBox
                                    x:Name="SuggestionsListBox"
                                    ItemsSource="{Binding TagSuggestions}"
                                    SelectedItem="{Binding SelectedTagSuggestion, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="6,4"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonUp="OnSuggestionClicked">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Tag24" Foreground="#0078D4" Margin="0,0,8,0" FontSize="13"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12.5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0:N0} posts'}" Foreground="#8492A6" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- SFW Shield Toolbar Pill -->
                    <Border
                        Grid.Column="2"
                        Background="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwBgConverter}}"
                        BorderBrush="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwBorderConverter}}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,0"
                        Height="38"
                        Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleSfwCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Symbol="Shield24"
                                Foreground="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwColorConverter}}"
                                Margin="0,0,6,0"
                                FontSize="14"/>
                            <TextBlock
                                Text="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwPillLabelConverter}}"
                                Foreground="#FFFFFF"
                                FontSize="12"
                                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Filter toggle -->
                    <ToggleButton
                        Grid.Column="4"
                        IsChecked="{Binding IsFilterOpen, Mode=TwoWay}"
                        Height="38" Padding="14,0"
                        Background="#1A202C" BorderBrush="#2D3548"
                        Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24" Margin="0,0,8,0" FontSize="14"/>
                            <TextBlock Text="Filters"/>
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- Expandable filter bar -->
                <Border
                    Visibility="{Binding IsFilterOpen, Converter={StaticResource BoolToVis}}"
                    Background="#161B27" BorderBrush="#262E40" BorderThickness="1"
                    CornerRadius="6" Margin="0,10,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Source Dropdown -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SOURCE:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                SelectedValue="{Binding SelectedSource}"
                                SelectedValuePath="Tag"
                                Height="32"
                                Width="220">
                                <ComboBoxItem Content="All Sources (Combined)" Tag="{x:Static models:BooruSource.All}" />
                                <ComboBoxItem Content="yande.re" Tag="{x:Static models:BooruSource.Yandere}" />
                                <ComboBoxItem Content="konachan.net (SFW)" Tag="{x:Static models:BooruSource.KonachanNet}" />
                                <ComboBoxItem Content="konachan.com (NSFW)" Tag="{x:Static models:BooruSource.KonachanCom}" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Ratio Dropdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RATIO:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                SelectedValue="{Binding SelectedAspectRatio}"
                                SelectedValuePath="Tag"
                                Height="32"
                                Width="160">
                                <ComboBoxItem Content="All Orientations" Tag="All" />
                                <ComboBoxItem Content="16:9 Landscape" Tag="16:9"/>
                                <ComboBoxItem Content="21:9 Ultrawide" Tag="21:9"/>
                                <ComboBoxItem Content="Landscape (Any)" Tag="Landscape"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Quality Dropdown -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="QUALITY:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                SelectedValue="{Binding SelectedMinQuality}"
                                SelectedValuePath="Tag"
                                Height="32"
                                Width="140">
                                <ComboBoxItem Content="All Qualities" Tag="All" />
                                <ComboBoxItem Content="4K UHD+" Tag="4K"/>
                                <ComboBoxItem Content="2K QHD+" Tag="2K"/>
                                <ComboBoxItem Content="FHD 1080p+" Tag="FHD"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Apply Button -->
                        <Button
                            Grid.Column="6"
                            Command="{Binding ApplyFiltersCommand}"
                            Height="32" Padding="18,0"
                            Background="#0078D4" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Content="Apply Filters"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Gallery Area ── -->
        <Grid Grid.Row="1">

            <!-- Loading skeleton -->
            <ScrollViewer
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                Padding="10">
                <UniformGrid Columns="4">
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                </UniformGrid>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40">
                <ui:SymbolIcon Symbol="ImageSearch24" FontSize="48" Foreground="#656E82" Margin="0,0,0,12"/>
                <TextBlock Text="No wallpapers found" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock
                    Text="{Binding ErrorMessage, TargetNullValue='Try a different search or adjust your filters.'}"
                    FontSize="12.5" Foreground="#9DA6B8" HorizontalAlignment="Center"
                    TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,0,0,14"/>
                <Button Command="{Binding SearchCommand}" Content="Retry" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Virtualized Gallery -->
            <ScrollViewer
                x:Name="GalleryScrollViewer"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="True"
                ScrollChanged="OnGalleryScrollChanged"
                SizeChanged="OnGallerySizeChanged"
                Padding="8,8,8,4">

                <ItemsControl
                    ItemsSource="{Binding PostRows}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GalleryRow Row="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Load-more bar -->
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}"
                VerticalAlignment="Bottom"
                Height="3"/>
        </Grid>
    </Grid>
</UserControl>
