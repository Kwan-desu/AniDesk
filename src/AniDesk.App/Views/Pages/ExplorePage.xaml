<UserControl
    x:Class="AniDesk.App.Views.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    xmlns:models="clr-namespace:AniDesk.Core.Models;assembly=AniDesk.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ExploreViewModel}">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Search + Filter Header ── -->
        <Border Grid.Row="0" Background="#B311151F" BorderBrush="#1F283C" BorderThickness="0,0,0,1" Padding="18,12,18,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search + autocomplete + Popular Mode Badge -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Popular Mode Badge -->
                        <Border
                            Grid.Column="0"
                            Visibility="{Binding IsPopularMode, Converter={StaticResource BoolToVis}}"
                            Background="#26F59E0B"
                            BorderBrush="#4DF59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0"
                            Height="38"
                            Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowTrending24" Foreground="#F59E0B" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Popular (Top Scored)" FontSize="11.5" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <!-- Glowing Search Container (matching ComboBox glow, no local properties blocking style triggers) -->
                            <Border x:Name="SearchBoxContainer"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Height="38"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#161B26" />
                                        <Setter Property="BorderBrush" Value="#2A3447" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1C2333" />
                                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#38BDF8" BlurRadius="10" Opacity="0.4" ShadowDepth="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="Background" Value="#1A2234" />
                                                <Setter Property="BorderBrush" Value="#38BDF8" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#38BDF8" BlurRadius="14" Opacity="0.55" ShadowDepth="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon that reacts to focus -->
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Symbol="Search24"
                                        FontSize="15"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchBoxContainer}" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBoxContainer}" Value="True">
                                                        <Setter Property="Foreground" Value="#38BDF8" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <!-- Input & Placeholder Area -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="Search tags (e.g. scenic, starry_sky, artist:wlop)..."
                                            Foreground="#64748B"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0"
                                            IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBox
                                            x:Name="SearchBox"
                                            Text="{Binding SearchTags, UpdateSourceTrigger=PropertyChanged}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#FFFFFF"
                                            CaretBrush="#38BDF8"
                                            VerticalContentAlignment="Center"
                                            FontSize="12"
                                            Margin="0,0,12,0"
                                            KeyboardNavigation.TabNavigation="None"
                                            PreviewKeyDown="OnSearchPreviewKeyDown"/>
                                    </Grid>
                                </Grid>
                            </Border>

                        <!-- Suggestions Dropdown Popup (Clicking an item searches) -->
                        <Popup
                            x:Name="SuggestionsPopup"
                            IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                            PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                            Placement="Bottom"
                            StaysOpen="False"
                            AllowsTransparency="True">
                            <Border
                                Width="{Binding ActualWidth, ElementName=SearchBoxContainer}"
                                MaxHeight="240"
                                Background="#171D2B"
                                BorderBrush="#2C374D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,4,0,0"
                                Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
                                </Border.Effect>
                                <ListBox
                                    x:Name="SuggestionsListBox"
                                    ItemsSource="{Binding TagSuggestions}"
                                    SelectedItem="{Binding SelectedTagSuggestion, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Setter Property="Margin" Value="2,1"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4,2">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1E3A8A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Margin="6,4"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                PreviewMouseLeftButtonUp="OnSuggestionClicked">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Tag24" Foreground="#0078D4" Margin="0,0,8,0" FontSize="13"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="12.5"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0:N0} posts'}" Foreground="#8492A6" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <!-- SFW Shield Toolbar Pill -->
                    <Border
                        Grid.Column="2"
                        Background="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwBgConverter}}"
                        BorderBrush="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwBorderConverter}}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,0"
                        Height="38"
                        Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ToggleSfwCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                Symbol="Shield24"
                                Foreground="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwColorConverter}}"
                                Margin="0,0,6,0"
                                FontSize="14"/>
                            <TextBlock
                                Text="{Binding DataContext.IsSfwShieldActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SfwPillLabelConverter}}"
                                Foreground="#FFFFFF"
                                FontSize="12"
                                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Filter toggle -->
                    <ToggleButton
                        Grid.Column="4"
                        IsChecked="{Binding IsFilterOpen, Mode=TwoWay}"
                        Height="38" Padding="14,0"
                        Background="#1A202C" BorderBrush="#2D3548"
                        Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Filter24" Margin="0,0,8,0" FontSize="14"/>
                            <TextBlock Text="Filters"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Refresh button -->
                    <Button
                        Grid.Column="6"
                        Command="{Binding SearchCommand}"
                        Width="38" Height="38"
                        Padding="0"
                        Background="#1A202C" BorderBrush="#2D3548" BorderThickness="1"
                        ToolTip="Refresh Wallpapers (F5)"
                        Cursor="Hand">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Foreground="#38BDF8" />
                    </Button>
                </Grid>

                <!-- Expandable filter bar (Auto-scales 100% across the full width with zero blank space) -->
                <Border
                    Visibility="{Binding IsFilterOpen, Converter={StaticResource BoolToVis}}"
                    Background="#161B27" BorderBrush="#262E40" BorderThickness="1"
                    CornerRadius="8" Margin="0,10,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Source: 1.35x star proportion -->
                            <ColumnDefinition Width="1.35*" MinWidth="180" />
                            <ColumnDefinition Width="14" />
                            <!-- Ratio: 1x star proportion -->
                            <ColumnDefinition Width="1*" MinWidth="140" />
                            <ColumnDefinition Width="14" />
                            <!-- Quality: 1x star proportion -->
                            <ColumnDefinition Width="1*" MinWidth="135" />
                            <ColumnDefinition Width="16" />
                            <!-- Apply Button: Auto width on far right -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Source Dropdown (Auto-scaling) -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SOURCE:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource AniDeskCleanComboBoxStyle}"
                                SelectedValue="{Binding SelectedSource}"
                                SelectedValuePath="Tag"
                                Height="38"
                                MinHeight="38"
                                VerticalContentAlignment="Center"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All Sources (Combined)" Tag="{x:Static models:BooruSource.All}" />
                                <ComboBoxItem Content="yande.re" Tag="{x:Static models:BooruSource.Yandere}" />
                                <ComboBoxItem Content="konachan.net (SFW)" Tag="{x:Static models:BooruSource.KonachanNet}" />
                                <ComboBoxItem Content="konachan.com (NSFW)" Tag="{x:Static models:BooruSource.KonachanCom}" />
                            </ComboBox>
                        </Grid>

                        <!-- Ratio Dropdown (Auto-scaling) -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RATIO:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource AniDeskCleanComboBoxStyle}"
                                SelectedValue="{Binding SelectedAspectRatio}"
                                SelectedValuePath="Tag"
                                Height="38"
                                MinHeight="38"
                                VerticalContentAlignment="Center"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All Orientations" Tag="All" />
                                <ComboBoxItem Content="16:9 Landscape" Tag="16:9"/>
                                <ComboBoxItem Content="21:9 Ultrawide" Tag="21:9"/>
                                <ComboBoxItem Content="Landscape (Any)" Tag="Landscape"/>
                            </ComboBox>
                        </Grid>

                        <!-- Quality Dropdown (Auto-scaling) -->
                        <Grid Grid.Column="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="QUALITY:" FontSize="10.5" FontWeight="Bold" Foreground="#8F9BB3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox
                                Grid.Column="1"
                                Style="{StaticResource AniDeskCleanComboBoxStyle}"
                                SelectedValue="{Binding SelectedMinQuality}"
                                SelectedValuePath="Tag"
                                Height="38"
                                MinHeight="38"
                                VerticalContentAlignment="Center"
                                FontSize="12"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="All Qualities" Tag="All" />
                                <ComboBoxItem Content="4K UHD+" Tag="4K"/>
                                <ComboBoxItem Content="2K QHD+" Tag="2K"/>
                                <ComboBoxItem Content="FHD 1080p+" Tag="FHD"/>
                            </ComboBox>
                        </Grid>

                        <!-- Apply Button (Anchored to right) -->
                        <Button
                            Grid.Column="6"
                            Command="{Binding ApplyFiltersCommand}"
                            Height="38" Padding="20,0"
                            Background="#0078D4" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Content="Apply Filters"
                            Cursor="Hand"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Gallery Area ── -->
        <Grid Grid.Row="1">

            <!-- Loading skeleton -->
            <ScrollViewer
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                Padding="10">
                <UniformGrid Columns="4">
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                    <Border Height="140" Margin="4" CornerRadius="10" Background="#181D2A"/>
                </UniformGrid>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40">
                <ui:SymbolIcon Symbol="ImageSearch24" FontSize="48" Foreground="#656E82" Margin="0,0,0,12"/>
                <TextBlock Text="No wallpapers found" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock
                    Text="{Binding ErrorMessage, TargetNullValue='Try a different search or adjust your filters.'}"
                    FontSize="12.5" Foreground="#9DA6B8" HorizontalAlignment="Center"
                    TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" Margin="0,0,0,14"/>
                <Button Command="{Binding SearchCommand}" Content="Retry" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Virtualized Gallery -->
            <ScrollViewer
                x:Name="GalleryScrollViewer"
                Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="True"
                ScrollChanged="OnGalleryScrollChanged"
                SizeChanged="OnGallerySizeChanged"
                Padding="8,8,8,4">

                <ItemsControl
                    ItemsSource="{Binding PostRows}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    ScrollViewer.CanContentScroll="True">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GalleryRow Row="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Centered Floating Circular ProgressRing Indicator -->
            <Border
                Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Panel.ZIndex="50"
                Background="#E6121724"
                BorderBrush="#29354A"
                BorderThickness="1"
                CornerRadius="22"
                Padding="18,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing
                        IsIndeterminate="True"
                        Width="22"
                        Height="22"
                        Foreground="#0078D4"
                        Margin="0,0,12,0" />
                    <TextBlock
                        Text="Loading more wallpapers..."
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
