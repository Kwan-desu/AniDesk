<UserControl
    x:Class="AniDesk.App.Views.Controls.CinematicOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    Focusable="True"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    KeyDown="OnKeyDown">

    <Grid x:Name="OverlayRoot">
        <!-- 1. Acrylic-Black Scrim (Click outside modal to dismiss) -->
        <Border
            Background="#E60A0D14"
            MouseLeftButtonDown="OnScrimMouseDown"
            Cursor="Arrow"/>

        <!-- 2. Main Theater Stage Modal -->
        <Border
            MaxWidth="1320"
            MaxHeight="860"
            Margin="36,24"
            CornerRadius="14"
            Background="#121622"
            ClipToBounds="True">

            <!-- Windows 11 Top-Lit Specular Edge Border -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness>1</Thickness>
            </Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />         <!-- Left: Interactive Pan & Zoom Canvas -->
                    <ColumnDefinition Width="1" />         <!-- Divider -->
                    <ColumnDefinition Width="380" />       <!-- Right: Inspector HUD & Action Center -->
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════════════════════════
                     LEFT: HIGH-RES ARTWORK CANVAS (Pan & Zoom)
                     ══════════════════════════════════════════════════════════════ -->
                <Grid
                    Grid.Column="0"
                    Background="#0A0D14"
                    ClipToBounds="True"
                    MouseWheel="OnCanvasMouseWheel"
                    MouseDown="OnCanvasMouseDown"
                    MouseMove="OnCanvasMouseMove"
                    MouseUp="OnCanvasMouseUp"
                    Cursor="SizeAll">

                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Background decoding placeholder icon -->
                    <ui:SymbolIcon
                        Symbol="Image24"
                        FontSize="48"
                        Foreground="#1F283C"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- High-Resolution Image -->
                    <Image
                        x:Name="HighResImage"
                        converters:AsyncImageLoader.ImageUrl="{Binding CinematicPost.SampleUrl}"
                        converters:AsyncImageLoader.DecodeWidth="1920"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- HUD: Floating Zoom Controls (Bottom Left of Canvas) -->
                    <Border
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="16"
                        Background="#990B0E17"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="ZoomLevelText"
                                Text="100%"
                                Foreground="#94A3B8"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Margin="4,0,8,0"/>
                            <Button
                                Content="Reset"
                                FontSize="10.5"
                                Padding="8,2"
                                Height="22"
                                Background="#22FFFFFF"
                                BorderThickness="0"
                                Foreground="#FFFFFF"
                                Click="OnResetZoomClicked"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Divider Line -->
                <Rectangle Grid.Column="1" Fill="#1E2536" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- ══════════════════════════════════════════════════════════════
                     RIGHT: INSPECTOR HUD & MULTI-MONITOR ACTION CENTER
                     ══════════════════════════════════════════════════════════════ -->
                <Grid Grid.Column="2" Background="#121622" DataContext="{Binding DetailVM}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header / Dismiss -->
                        <RowDefinition Height="*" />    <!-- Scrollable Metadata & Displays -->
                        <RowDefinition Height="Auto" /> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar with Dismiss Button -->
                    <DockPanel Grid.Row="0" Margin="18,16,16,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="WALLPAPER INSPECTOR" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Post.Id, StringFormat='{}Post #{0}'}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" />
                        </StackPanel>

                        <Button
                            DockPanel.Dock="Right"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="#1C2333"
                            BorderBrush="#2A354C"
                            BorderThickness="1"
                            Foreground="#CBD5E1"
                            Click="OnCloseClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                        </Button>
                    </DockPanel>

                    <!-- Scrollable Metadata Details -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,12">
                        <StackPanel>
                            <!-- Dimension & Aspect Pill -->
                            <TextBlock Text="DIMENSIONS &amp; RESOLUTION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,12,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="#1E273A" BorderBrush="#2F3C57" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Post.FormattedDimensions}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#142B3B" BorderBrush="#1D4A66" BorderThickness="1" CornerRadius="4" Padding="7,3">
                                    <TextBlock Text="{Binding Post.AspectSummary}" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold"/>
                                </Border>
                            </WrapPanel>

                            <!-- Author / Booru Source -->
                            <TextBlock Text="ARTIST &amp; BOORU SOURCE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                <TextBlock Text="{Binding Post.Author}" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                <Button
                                    DockPanel.Dock="Right"
                                    Command="{Binding OpenSourceUrlCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Foreground="#38BDF8"
                                    FontSize="11.5"
                                    Cursor="Hand">
                                    <TextBlock Text="↗ Open Booru" />
                                </Button>
                            </DockPanel>

                            <!-- File Size -->
                            <TextBlock Text="FILE SIZE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Post.FormattedFileSize}" FontSize="12.5" Foreground="#CBD5E1" Margin="0,0,0,16"/>

                            <Separator Background="#1E2536" Margin="0,0,0,14" />

                            <!-- ── MULTI-MONITOR DESK VISUALIZER ── -->
                            <TextBlock Text="TARGET DISPLAY" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <TextBlock Text="Choose which monitor to apply this wallpaper to:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                            <!-- Interactive Visual Displays Diagram -->
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="0,0,8,8"
                                            Padding="10,8"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Click="OnMonitorCardClicked">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#182030" BorderBrush="#2D3B54" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Foreground="#38BDF8" Margin="0,0,8,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock FontSize="10" Foreground="#94A3B8">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}×{1}">
                                                                <Binding Path="Width" />
                                                                <Binding Path="Height" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Monitor fallback combobox -->
                            <ComboBox
                                Style="{StaticResource AniDeskCleanComboBoxStyle}"
                                ItemsSource="{Binding Monitors}"
                                SelectedItem="{Binding SelectedMonitor}"
                                Height="38"
                                MinHeight="38"
                                VerticalContentAlignment="Center"
                                FontSize="12"
                                Margin="0,6,0,14">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Desktop24" FontSize="14" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Status notification message -->
                            <Border
                                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"
                                Background="#162E20"
                                BorderBrush="#22C55E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,10">
                                <TextBlock
                                    Text="{Binding StatusMessage}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#4ADE80"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3-Tier Sticky Action Center (Bottom) -->
                    <Border Grid.Row="2" Background="#0F131D" BorderBrush="#1E2536" BorderThickness="0,1,0,0" Padding="18,14">
                        <StackPanel>
                            <!-- Primary CTA: Set Desktop Wallpaper -->
                            <Button
                                Command="{Binding SetWallpaperCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Height="42"
                                Background="#0078D4"
                                Foreground="#FFFFFF"
                                FontWeight="SemiBold"
                                FontSize="13"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0" FontSize="16" />
                                    <TextBlock Text="Set Desktop Wallpaper" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Tier: Lock Screen + Favorite -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    Command="{Binding SetLockScreenCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Height="34"
                                    Background="#1A2130"
                                    BorderBrush="#2B374E"
                                    BorderThickness="1"
                                    Foreground="#E2E8F0"
                                    FontSize="12"
                                    HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0" FontSize="14" />
                                        <TextBlock Text="Set Lock Screen" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Width="38"
                                    Height="34"
                                    Background="#1A2130"
                                    BorderBrush="#2B374E"
                                    BorderThickness="1"
                                    ToolTip="Bookmark Favorite">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <ui:SymbolIcon
                                        Symbol="Heart24"
                                        Filled="{Binding Post.IsFavorite}"
                                        Foreground="{Binding Post.IsFavorite, Converter={StaticResource BoolToBrushConverter}}"
                                        FontSize="15" />
                                </Button>
                            </Grid>

                            <!-- Tertiary Row: Download Original Full-Res -->
                            <Button
                                Command="{Binding DownloadOriginalCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Height="30"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94A3B8"
                                FontSize="11.5"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" FontSize="13" />
                                    <TextBlock Text="Download Original Full-Res File" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
