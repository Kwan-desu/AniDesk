<Window
    x:Class="AniDesk.App.Views.Controls.ShortcutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Record Shortcut"
    Width="480"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False">

    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="6" Opacity="0.65" Color="#000000" />
    </Window.Resources>

    <Grid Margin="16">
        <Border
            Background="#121622"
            BorderBrush="#253248"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24,20"
            Effect="{StaticResource DialogShadow}">
            <StackPanel>
                <!-- ══════════════════════════════════════════════════════════════
                     HEADER: TITLE & DISMISS
                     ══════════════════════════════════════════════════════════════ -->
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Press a shortcut" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Press a 3-key combination (e.g. Win + Shift + H) to record your keybind" FontSize="11.5" Foreground="#94A3B8" Margin="24,3,0,0" />
                    </StackPanel>

                    <Button
                        DockPanel.Dock="Right"
                        Width="28" Height="28"
                        Padding="0"
                        Background="#1A2234"
                        BorderBrush="#253248"
                        BorderThickness="1"
                        Foreground="#94A3B8"
                        ToolTip="Close (Esc)"
                        Click="OnCancelClicked"
                        VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                    </Button>
                </DockPanel>

                <!-- ══════════════════════════════════════════════════════════════
                     RECORDING DISPLAY BOX
                     ══════════════════════════════════════════════════════════════ -->
                <Border
                    x:Name="RecordingBorder"
                    Height="74"
                    Background="#0B0F17"
                    BorderBrush="#222B3D"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Margin="0,18,0,18"
                    VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Initial Prompt: No key detected yet -->
                        <TextBlock
                            x:Name="NoKeyText"
                            Text="No key detected yet"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <!-- Detected Key Cap Badges -->
                        <ItemsControl x:Name="KeyBadgesItemsControl" Visibility="Collapsed" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="#282315"
                                        BorderBrush="#A16207"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="30"
                                        Height="30"
                                        Padding="9,3"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Win Glyph -->
                                            <TextBlock
                                                Text="⊞"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#FDE047"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsWinKey, Converter={StaticResource BoolToVis}}" />

                                            <!-- Shift Glyph -->
                                            <TextBlock
                                                Text="⇧"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#FDE047"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsShiftKey, Converter={StaticResource BoolToVis}}" />

                                            <!-- Text Label (Ctrl, Alt, Key) -->
                                            <TextBlock
                                                Text="{Binding Text}"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="#FDE047"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSpecialSymbol, Converter={StaticResource InverseBoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════════════════════════
                     ACTION FOOTER: RESET (LEFT) & CANCEL/SAVE (RIGHT)
                     ══════════════════════════════════════════════════════════════ -->
                <DockPanel LastChildFill="False">
                    <!-- Reset Button -->
                    <Button
                        DockPanel.Dock="Left"
                        Height="34"
                        Padding="14,0"
                        Background="#1A2234"
                        BorderBrush="#2A374E"
                        BorderThickness="1"
                        Foreground="#E2E8F0"
                        ToolTip="Reset to default shortcut (Win + Shift + H)"
                        Click="OnResetClicked"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reset" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            Height="34"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Background="#1A2234"
                            BorderBrush="#2A374E"
                            BorderThickness="1"
                            Foreground="#94A3B8"
                            Content="Cancel"
                            FontSize="12"
                            Click="OnCancelClicked"
                            VerticalAlignment="Center" />

                        <Button
                            x:Name="SaveButton"
                            Height="34"
                            Padding="18,0"
                            Background="#0078D4"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="12"
                            Content="Save"
                            IsEnabled="False"
                            Click="OnSaveClicked"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
