<UserControl
    x:Class="AniDesk.App.Views.Controls.WallpaperDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:WallpaperDetailViewModel}">

    <Border
        Background="#D9161B26"
        BorderBrush="#262D3E"
        BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18,16,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Image Preview -->
                    <RowDefinition Height="Auto" /> <!-- Metadata Flow -->
                    <RowDefinition Height="*" />    <!-- Spacer -->
                    <RowDefinition Height="Auto" /> <!-- Actions Section -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Text="Wallpaper Details"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#FFFFFF" />

                    <Button
                        DockPanel.Dock="Right"
                        Command="{Binding CloseCommand}"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#9DA6B8">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                    </Button>
                </DockPanel>

                <!-- 2. High-Res Image Preview Box -->
                <Border
                    Grid.Row="1"
                    MinHeight="140"
                    MaxHeight="260"
                    CornerRadius="10"
                    Background="#1E2433"
                    BorderBrush="#333E54"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Margin="0,0,0,14">
                    <Image
                        converters:AsyncImageLoader.ImageUrl="{Binding Post.SampleUrl}"
                        converters:AsyncImageLoader.DecodeWidth="600"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <!-- 3. Continuous Flow Metadata Hierarchy -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <!-- Resolution & Aspect -->
                    <TextBlock Text="RESOLUTION &amp; ASPECT" FontSize="10" FontWeight="Bold" Foreground="#656E82" Margin="0,0,0,2"/>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10">
                        <Run Text="{Binding Post.FormattedDimensions, Mode=OneWay}" />
                        <Run Text=" (" /><Run Text="{Binding Post.AspectSummary, Mode=OneWay}" Foreground="#0078D4" /><Run Text=")" />
                    </TextBlock>

                    <!-- Artist & Source -->
                    <TextBlock Text="ARTIST &amp; SOURCE" FontSize="10" FontWeight="Bold" Foreground="#656E82" Margin="0,0,0,2"/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Post.Author}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E6EE" Margin="0,0,8,0" />
                        <Button
                            Command="{Binding OpenSourceUrlCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Foreground="#0078D4"
                            FontSize="11.5"
                            Cursor="Hand">
                            <TextBlock Text="↗ Open in Booru" />
                        </Button>
                    </WrapPanel>

                    <!-- File Size & Format -->
                    <TextBlock Text="FILE SIZE" FontSize="10" FontWeight="Bold" Foreground="#656E82" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Post.FormattedFileSize}" FontSize="12.5" Foreground="#E2E6EE" Margin="0,0,0,10" />

                </StackPanel>

                <!-- 4. 3-Tier Action Center -->
                <StackPanel Grid.Row="4">
                    <Separator Background="#222838" Margin="0,0,0,12" />

                    <!-- Target Display Selector -->
                    <TextBlock Text="APPLY TO DISPLAY" FontSize="10" FontWeight="Bold" Foreground="#656E82" Margin="0,0,0,4" />
                    <ComboBox
                        ItemsSource="{Binding Monitors}"
                        SelectedItem="{Binding SelectedMonitor}"
                        DisplayMemberPath="DisplayName"
                        Height="32"
                        Margin="0,0,0,10" />

                    <!-- High-Contrast Status Notification Banner -->
                    <Border
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"
                        Background="#162E20"
                        BorderBrush="#22C55E"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,0,0,10">
                        <TextBlock
                            Text="{Binding StatusMessage}"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#4ADE80"
                            TextWrapping="Wrap" />
                    </Border>

                    <!-- Tier 1: Primary Action (Filled Accent with Ambient Glow) -->
                    <Button
                        Command="{Binding SetWallpaperCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Height="40"
                        Background="#0078D4"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0" FontSize="16" />
                            <TextBlock Text="Set as Wallpaper" />
                        </StackPanel>
                    </Button>

                    <!-- Tier 2: Secondary Row (Set Lock Screen + Favorite Button) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Command="{Binding SetLockScreenCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Height="34"
                            Background="#202636"
                            BorderBrush="#2F384C"
                            Foreground="#E2E8F0"
                            FontSize="12"
                            HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0" FontSize="14" />
                                <TextBlock Text="Set Lock Screen" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="2"
                            Command="{Binding ToggleFavoriteCommand}"
                            Width="36"
                            Height="34"
                            Background="#202636"
                            BorderBrush="#2F384C"
                            ToolTip="Add to Favorites">
                            <ui:SymbolIcon
                                Symbol="Star24"
                                Filled="{Binding Post.IsFavorite}"
                                Foreground="{Binding Post.IsFavorite, Converter={StaticResource BoolToBrushConverter}}"
                                FontSize="15" />
                        </Button>
                    </Grid>

                    <!-- Tier 3: Tertiary Ghost Button (Download Original) -->
                    <Button
                        Command="{Binding DownloadOriginalCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Height="32"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="#9DA6B8"
                        FontSize="11.5"
                        HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0" FontSize="14" />
                            <TextBlock Text="Download Original Full Res" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
