<UserControl
    x:Class="AniDesk.App.Views.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Cursor="Hand"
    Margin="4"
    MinHeight="100"
    SizeChanged="OnCardSizeChanged">

    <Border
        x:Name="CardBorder"
        CornerRadius="10"
        Background="#181D2A"
        BorderBrush="#1E2536"
        BorderThickness="1"
        ClipToBounds="True"
        PreviewMouseLeftButtonUp="OnCardClicked">

        <Grid x:Name="CardContentGrid">
            <!-- Thumbnail -->
            <Image
                x:Name="ThumbImage"
                converters:AsyncImageLoader.ImageUrl="{Binding ThumbnailUrl}"
                converters:AsyncImageLoader.DecodeWidth="420"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <!-- Hover overlay -->
            <Grid x:Name="HoverOverlay" Opacity="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#D9000000" Offset="0"/>
                        <GradientStop Color="#44000000" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Bookmark -->
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Width="30" Height="30"
                    Padding="0"
                    Background="#99000000"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    Click="OnFavoriteClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon
                        Symbol="Heart24"
                        Filled="{Binding IsFavorite}"
                        Foreground="#E05070"
                        FontSize="14"/>
                </Button>

                <!-- Resolution pill -->
                <Border
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="8"
                    Background="#CC000000"
                    CornerRadius="4"
                    Padding="6,2">
                    <TextBlock
                        Text="{Binding FormattedDimensions}"
                        Foreground="#FFFFFF"
                        FontSize="10.5"
                        FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Grid>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="HoverOverlay"
                        Storyboard.TargetProperty="Opacity"
                        To="1" Duration="0:0:0.14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="HoverOverlay"
                        Storyboard.TargetProperty="Opacity"
                        To="0" Duration="0:0:0.14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
