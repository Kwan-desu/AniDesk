<UserControl
    x:Class="AniDesk.App.Views.Controls.WallpaperCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:AniDesk.App.Converters"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Cursor="Hand"
    Margin="4"
    MinHeight="90"
    SizeChanged="OnCardSizeChanged"
    DataContextChanged="OnCardDataContextChanged">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Set as Desktop Wallpaper" Click="OnContextMenuSetWallpaper">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set as Lock Screen" Click="OnContextMenuSetLockScreen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Toggle Favorite" Click="OnContextMenuToggleFavorite">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Star24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Download Original" Click="OnContextMenuDownload">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Copy Image URL" Click="OnContextMenuCopyUrl">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <controls:ClippingBorder
        x:Name="CardBorder"
        CornerRadius="8"
        Background="#181D2A"
        BorderThickness="1"
        ClipToBounds="True"
        PreviewMouseLeftButtonUp="OnCardClicked">

        <!-- Windows 11 Top-Lit Specular Edge Highlight -->
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#24FFFFFF" Offset="0" />
                <GradientStop Color="#0AFFFFFF" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid x:Name="CardContentGrid">
            <!-- Fallback broken-image icon if image source fails or null -->
            <ui:SymbolIcon Symbol="ImageSearch24" FontSize="28" Foreground="#2A3348" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Thumbnail -->
            <Image
                x:Name="ThumbImage"
                converters:AsyncImageLoader.ImageUrl="{Binding ThumbnailUrl}"
                converters:AsyncImageLoader.DecodeWidth="420"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

            <!-- Hover overlay -->
            <Grid x:Name="HoverOverlay" Opacity="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#E6000000" Offset="0"/>
                        <GradientStop Color="#44000000" Offset="0.55"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Bookmark Button (Top Right) -->
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Width="30" Height="30"
                    Padding="0"
                    Background="#99000000"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    Click="OnFavoriteClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:SymbolIcon
                        Symbol="Heart24"
                        Filled="{Binding IsFavorite}"
                        Foreground="#E05070"
                        FontSize="14"/>
                </Button>

                <!-- Bottom Bar: Aspect/Resolution Pill (Left) + Quick-Set Button (Right) -->
                <Grid VerticalAlignment="Bottom" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Resolution & Aspect Tag Pill -->
                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Background="#CC000000"
                        BorderBrush="#22FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,3">
                        <TextBlock
                            Text="{Binding FormattedDimensions}"
                            Foreground="#FFFFFF"
                            FontSize="10.5"
                            FontWeight="SemiBold"/>
                    </Border>

                    <!-- Quick "Set" Button -->
                    <Button
                        Grid.Column="1"
                        Height="26"
                        Padding="8,0"
                        Background="#D90078D4"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Click="OnQuickSetClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" Foreground="#FFFFFF" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Set" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </controls:ClippingBorder>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="HoverOverlay"
                        Storyboard.TargetProperty="Opacity"
                        To="1" Duration="0:0:0.14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetName="HoverOverlay"
                        Storyboard.TargetProperty="Opacity"
                        To="0" Duration="0:0:0.14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
