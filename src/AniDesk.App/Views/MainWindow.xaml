<ui:FluentWindow
    x:Class="AniDesk.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:pages="clr-namespace:AniDesk.App.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    Title="AniDesk — Wallpaper Explorer"
    Icon="/anidesk.ico"
    Width="1340" Height="840"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <Grid Background="#0D0F16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />    <!-- Main App Body -->
        </Grid.RowDefinitions>

        <!-- 1. Native Windows 11 TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="AniDesk — Wallpaper Explorer"
            Height="36"
            FontSize="12" />

        <!-- 2. Main App Body (Sidebar + Content + Detail Inspector) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" /> <!-- Left Nav Rail -->
                <ColumnDefinition Width="*" />   <!-- Center Content Pages -->
                <ColumnDefinition Width="Auto" /> <!-- Right Detail Drawer -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0" Background="#12151E" BorderBrush="#1F2432" BorderThickness="0,0,1,0" Padding="10,12,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Nav Items -->
                        <RowDefinition Height="Auto" /> <!-- Preferences & Safety Footer -->
                    </Grid.RowDefinitions>

                    <!-- Nav Items Group -->
                    <StackPanel Grid.Row="0">
                        <!-- Explore -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Explore"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Icon="Compass24"
                            Content="Explore" />

                        <!-- Popular -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Popular"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="ArrowTrending24"
                            Content="Popular" />

                        <!-- Favorites -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Favorites"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="Star24"
                            Content="Favorites" />

                        <!-- Downloads -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Downloads"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="ArrowDownload24"
                            Content="Downloads" />
                    </StackPanel>

                    <!-- PREFERENCES & SAFETY GROUP (Bottom Rail) -->
                    <StackPanel Grid.Row="1">
                        <Separator Background="#222838" Margin="4,0,4,10" />
                        <TextBlock Text="PREFERENCES &amp; SAFETY" FontSize="9.5" FontWeight="Bold" Foreground="#586174" Margin="6,0,0,8" />

                        <!-- SFW Shield / NSFW Mode Switch Card -->
                        <Border
                            Background="{Binding IsSfwShieldActive, Converter={StaticResource SfwBgConverter}}"
                            BorderBrush="{Binding IsSfwShieldActive, Converter={StaticResource SfwBorderConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Symbol="Shield24"
                                    Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}"
                                    Margin="0,0,8,0"
                                    FontSize="16" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwTitleConverter}}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF" />
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwStatusConverter}}"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}" />
                                </StackPanel>

                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding IsSfwShieldActive, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <!-- Settings Nav -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            FontSize="13"
                            Icon="Settings24"
                            Content="Settings" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER CONTENT PAGES (Switched via MVVM DataTemplates) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:ExploreViewModel}">
                        <pages:ExplorePage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                        <pages:FavoritesPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                        <pages:DownloadsPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <pages:SettingsPage />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- RIGHT DETAIL INSPECTOR DRAWER -->
            <controls:WallpaperDetailPanel
                Grid.Column="2"
                Width="320"
                DataContext="{Binding DetailVM}"
                Visibility="{Binding DataContext.IsDetailPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
