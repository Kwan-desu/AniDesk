<ui:FluentWindow
    x:Class="AniDesk.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:pages="clr-namespace:AniDesk.App.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    Title="AniDesk — Wallpaper Explorer"
    Icon="/anidesk.ico"
    Width="1340" Height="840"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="F5" Command="{Binding ExploreVM.SearchCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding ExploreVM.SearchCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />    <!-- Main App Body -->
        </Grid.RowDefinitions>

        <!-- 1. Native Windows 11 TitleBar with Sidebar Toggle -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Toggle Button (Always accessible at top-left) -->
            <Button
                Grid.Column="0"
                Command="{Binding ToggleSidebarCommand}"
                ToolTip="Toggle Sidebar (Ctrl+B)"
                Width="42" Height="36"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#94A3B8">
                <ui:SymbolIcon Symbol="PanelLeft24" FontSize="15" />
            </Button>

            <!-- TitleBar -->
            <ui:TitleBar
                Grid.Column="1"
                Title="AniDesk — Wallpaper Explorer"
                Height="36"
                FontSize="12" />
        </Grid>

        <!-- 2. Main App Body (Sidebar + Content + Detail Inspector + Cinematic Overlay) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Left Nav Rail (Collapsible) -->
                <ColumnDefinition Width="*" />    <!-- Center Content Pages -->
                <ColumnDefinition Width="Auto" /> <!-- Right Detail Drawer -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL -->
            <Border
                Grid.Column="0"
                Width="220"
                Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource TranslucentNavRailBackground}"
                BorderBrush="#1F283C"
                BorderThickness="0,0,1,0"
                Padding="10,8,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Nav Items -->
                        <RowDefinition Height="Auto" /> <!-- Preferences & Safety Footer -->
                    </Grid.RowDefinitions>

                    <!-- Nav Items Group -->
                    <StackPanel Grid.Row="0">
                        <!-- Top Rail Header -->
                        <TextBlock Text="NAVIGATION" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="10,4,0,12"/>

                        <!-- Explore -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Explore"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Icon="Compass24"
                            Content="Explore"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Explore'}"
                            Background="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Explore'}" />

                        <!-- Popular -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Popular"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="ArrowTrending24"
                            Content="Popular"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Popular'}"
                            Background="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Popular'}" />

                        <!-- Favorites -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Favorites"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="Star24"
                            Content="Favorites"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Favorites'}"
                            Background="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Favorites'}" />

                        <!-- Downloads -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Downloads"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4"
                            Padding="12,8"
                            FontSize="13"
                            Icon="ArrowDownload24"
                            Content="Downloads"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Downloads'}"
                            Background="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Downloads'}" />
                    </StackPanel>

                    <!-- PREFERENCES & SAFETY GROUP (Bottom Rail) -->
                    <StackPanel Grid.Row="1">
                        <Separator Background="#1E2536" Margin="4,0,4,10" />
                        <TextBlock Text="PRIVACY &amp; SHIELD" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="6,0,0,8" />

                        <!-- Discrete SFW Shield Status Card -->
                        <Border
                            Background="{Binding IsSfwShieldActive, Converter={StaticResource SfwBgConverter}}"
                            BorderBrush="{Binding IsSfwShieldActive, Converter={StaticResource SfwBorderConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Symbol="Shield24"
                                    Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}"
                                    Margin="0,0,8,0"
                                    FontSize="16" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwTitleConverter}}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF" />
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwStatusConverter}}"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}" />
                                </StackPanel>

                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding IsSfwShieldActive, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <!-- Settings Nav -->
                        <ui:Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            FontSize="13"
                            Icon="Settings24"
                            Content="Settings"
                            BorderThickness="3,0,0,0"
                            BorderBrush="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Settings'}"
                            Background="{Binding CurrentNavView, Converter={StaticResource StringEqualsToBrushConverter}, ConverterParameter='Settings'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER CONTENT PAGES (Switched via MVVM DataTemplates) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:ExploreViewModel}">
                        <pages:ExplorePage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                        <pages:FavoritesPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                        <pages:DownloadsPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <pages:SettingsPage />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- RIGHT DETAIL INSPECTOR DRAWER (Kept for optional side inspection) -->
            <controls:WallpaperDetailPanel
                Grid.Column="2"
                Width="320"
                DataContext="{Binding DetailVM}"
                Visibility="{Binding DataContext.IsDetailPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- FULL THEATER CINEMATIC OVERLAY (Spans full window body) -->
            <controls:CinematicOverlay
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Visibility="{Binding IsCinematicOpen, Converter={StaticResource BoolToVis}}" />

            <!-- FLOATING GLASS TOAST NOTIFICATION (Appears on wallpaper/lockscreen applied) -->
            <Border
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Panel.ZIndex="9999"
                IsHitTestVisible="False"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Background="#E6101420"
                BorderBrush="#3322C55E"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10,22,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#2622C55E" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#22C55E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitle}" FontSize="11" FontWeight="Bold" Foreground="#22C55E" Margin="0,0,0,1" />
                        <TextBlock Text="{Binding ToastMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
