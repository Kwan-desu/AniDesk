<ui:FluentWindow
    x:Class="AniDesk.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:AniDesk.App.Views.Controls"
    xmlns:pages="clr-namespace:AniDesk.App.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AniDesk.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainViewModel}"
    Title="AniDesk — Wallpaper Explorer"
    Icon="/anidesk.ico"
    Width="1340" Height="840"
    MinWidth="960" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="F5" Command="{Binding ExploreVM.SearchCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding ExploreVM.SearchCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AniDeskCleanComboBoxStyle}" />
    </ui:FluentWindow.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />    <!-- Main App Body -->
        </Grid.RowDefinitions>        <!-- 1. Native Windows 11 TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="AniDesk — Wallpaper Explorer"
            Height="36"
            FontSize="12" />

        <!-- 2. Main App Body (Sidebar + Content + Detail Inspector + Cinematic Overlay) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Left Nav Rail (Collapsible to compact) -->
                <ColumnDefinition Width="*" />    <!-- Center Content Pages -->
                <ColumnDefinition Width="Auto" /> <!-- Right Detail Drawer -->
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION RAIL (Modern Rail: 220px Expanded, 64px Compact) -->
            <Border
                Grid.Column="0"
                Width="{Binding IsSidebarCompact, Converter={StaticResource BoolToSidebarWidthConverter}}"
                Background="{StaticResource TranslucentNavRailBackground}"
                BorderBrush="#1F283C"
                BorderThickness="0,0,1,0"
                Padding="6,8,6,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Nav Items -->
                        <RowDefinition Height="Auto" /> <!-- Preferences & Safety Footer -->
                    </Grid.RowDefinitions>

                    <!-- Nav Items Group -->
                    <StackPanel Grid.Row="0">
                        <!-- Top Rail Header with In-Sidebar Toggle Button -->
                        <Grid Margin="4,2,4,12">
                            <!-- Expanded Title -->
                            <TextBlock
                                Text="NAVIGATION"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Foreground="#64748B"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVis}}"/>

                            <!-- Sidebar Toggle Button (Inside the sidebar rail) -->
                            <Button
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip="Toggle Sidebar (Ctrl+B)"
                                Width="44" Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#94A3B8"
                                HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="PanelLeft24" FontSize="15" />
                            </Button>
                        </Grid>

                        <!-- Explore -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Explore"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,2"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Explore Wallpapers">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Height="40" SnapsToDevicePixels="True">
                                        <!-- Background highlight on hover/active -->
                                        <Border x:Name="BgHighlight"
                                                Background="Transparent"
                                                CornerRadius="6" />
                                        <!-- Active pill indicator (left edge) -->
                                        <Rectangle x:Name="ActivePill"
                                                   Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Fill="Transparent"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,0" />
                                        <!-- Compact icon (centered) -->
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="CompassNorthwest24" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#38BDF8"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <!-- Expanded row (icon + label) -->
                                        <Grid x:Name="ExpandedRow"
                                              Margin="10,0"
                                              Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="CompassNorthwest24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Explore"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentNavView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Explore">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#1E38BDF8" />
                                            <Setter TargetName="ActivePill" Property="Fill" Value="#38BDF8" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#12FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Popular -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Popular"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,2"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Popular Wallpapers">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Height="40" SnapsToDevicePixels="True">
                                        <Border x:Name="BgHighlight"
                                                Background="Transparent"
                                                CornerRadius="6" />
                                        <Rectangle x:Name="ActivePill"
                                                   Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Fill="Transparent"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="ArrowTrending24" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#F59E0B"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <Grid x:Name="ExpandedRow"
                                              Margin="10,0"
                                              Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowTrending24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F59E0B"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Popular"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentNavView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Popular">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#1EF59E0B" />
                                            <Setter TargetName="ActivePill" Property="Fill" Value="#F59E0B" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#12FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Favorites -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Favorites"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,2"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Favorite Wallpapers">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Height="40" SnapsToDevicePixels="True">
                                        <Border x:Name="BgHighlight"
                                                Background="Transparent"
                                                CornerRadius="6" />
                                        <Rectangle x:Name="ActivePill"
                                                   Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Fill="Transparent"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="Star24" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#EC4899"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <Grid x:Name="ExpandedRow"
                                              Margin="10,0"
                                              Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Star24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EC4899"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Favorites"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentNavView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Favorites">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#1EEC4899" />
                                            <Setter TargetName="ActivePill" Property="Fill" Value="#EC4899" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#12FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Downloads -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Downloads"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,2"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Downloaded Wallpapers">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Height="40" SnapsToDevicePixels="True">
                                        <Border x:Name="BgHighlight"
                                                Background="Transparent"
                                                CornerRadius="6" />
                                        <Rectangle x:Name="ActivePill"
                                                   Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Fill="Transparent"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="ArrowDownload24" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#10B981"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <Grid x:Name="ExpandedRow"
                                              Margin="10,0"
                                              Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Downloads"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentNavView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Downloads">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#1E10B981" />
                                            <Setter TargetName="ActivePill" Property="Fill" Value="#10B981" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#12FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- PREFERENCES & SAFETY GROUP (Bottom Rail) -->
                    <StackPanel Grid.Row="1">
                        <Separator Background="#1E2536" Margin="4,0,4,10" />

                        <!-- Compact SFW Shield Button -->
                        <Button
                            Command="{Binding ToggleSfwCommand}"
                            Visibility="{Binding IsSidebarCompact, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding IsSfwShieldActive, Converter={StaticResource SfwTitleConverter}}"
                            HorizontalAlignment="Center"
                            Width="44" Height="40"
                            Margin="0,0,0,8"
                            Background="{Binding IsSfwShieldActive, Converter={StaticResource SfwBgConverter}}"
                            BorderBrush="{Binding IsSfwShieldActive, Converter={StaticResource SfwBorderConverter}}"
                            BorderThickness="1">
                            <ui:SymbolIcon
                                Symbol="Shield24"
                                Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}"
                                FontSize="16" />
                        </Button>

                        <!-- Expanded SFW Shield Card -->
                        <Border
                            Visibility="{Binding IsSidebarCompact, Converter={StaticResource InverseBoolToVis}}"
                            Background="{Binding IsSfwShieldActive, Converter={StaticResource SfwBgConverter}}"
                            BorderBrush="{Binding IsSfwShieldActive, Converter={StaticResource SfwBorderConverter}}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon
                                    Grid.Column="0"
                                    Symbol="Shield24"
                                    Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}"
                                    Margin="0,0,8,0"
                                    FontSize="16" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwTitleConverter}}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#FFFFFF" />
                                    <TextBlock
                                        Text="{Binding IsSfwShieldActive, Converter={StaticResource SfwStatusConverter}}"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{Binding IsSfwShieldActive, Converter={StaticResource SfwColorConverter}}" />
                                </StackPanel>

                                <ui:ToggleSwitch
                                    Grid.Column="2"
                                    IsChecked="{Binding IsSfwShieldActive, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <!-- Settings Nav -->
                        <Button
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            HorizontalAlignment="Stretch"
                            Padding="0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Settings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Height="40" SnapsToDevicePixels="True">
                                        <Border x:Name="BgHighlight"
                                                Background="Transparent"
                                                CornerRadius="6" />
                                        <Rectangle x:Name="ActivePill"
                                                   Width="3" Height="18"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Fill="Transparent"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <ui:SymbolIcon x:Name="NavIcon"
                                                       Symbol="Settings24" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#94A3B8"
                                                       Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <Grid x:Name="ExpandedRow"
                                              Margin="10,0"
                                              Visibility="{Binding DataContext.IsSidebarCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Grid.Column="0" Symbol="Settings24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="Settings"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.CurrentNavView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#1E94A3B8" />
                                            <Setter TargetName="ActivePill" Property="Fill" Value="#94A3B8" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgHighlight" Property="Background" Value="#12FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER CONTENT PAGES (Switched via MVVM DataTemplates) -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:ExploreViewModel}">
                        <pages:ExplorePage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FavoritesViewModel}">
                        <pages:FavoritesPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                        <pages:DownloadsPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <pages:SettingsPage />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- RIGHT DETAIL INSPECTOR DRAWER (Kept for optional side inspection) -->
            <controls:WallpaperDetailPanel
                Grid.Column="2"
                Width="320"
                DataContext="{Binding DetailVM}"
                Visibility="{Binding DataContext.IsDetailPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- FULL THEATER CINEMATIC OVERLAY (Spans full window body) -->
            <controls:CinematicOverlay
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Visibility="{Binding IsCinematicOpen, Converter={StaticResource BoolToVis}}" />

            <!-- FLOATING GLASS TOAST NOTIFICATION (Appears on wallpaper/lockscreen applied) -->
            <Border
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Panel.ZIndex="9999"
                IsHitTestVisible="False"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Background="#E6101420"
                BorderBrush="#3322C55E"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16,10,22,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="14" Background="#2622C55E" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="Checkmark24" Foreground="#22C55E" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToastTitle}" FontSize="11" FontWeight="Bold" Foreground="#22C55E" Margin="0,0,0,1" />
                        <TextBlock Text="{Binding ToastMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
